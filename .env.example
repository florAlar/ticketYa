# TicketYa – variables de entorno (desarrollo local)
# Copiar a .env en la raíz o en Backend/ según dónde se ejecute docker compose.
# No subir el archivo .env real al repositorio.

# MySQL (compartido por convención en los compose de cada msvc)
MYSQL_PASSWORD=ticketya_dev
MYSQL_ROOT_PASSWORD=root_dev

# MongoDB (msvc-preferencias)
MONGO_PASSWORD=mongo_dev

# Opcional: sobrescribir puertos o perfiles más adelante
# COMPOSE_PROJECT_NAME=ticketya
