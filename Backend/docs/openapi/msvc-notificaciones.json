{
  "openapi": "3.1.0",
  "info": {
    "title": "TicketYa — Notificaciones (Email / Push y Bandeja)",
    "description": "Bandeja de notificaciones del usuario autenticado (una entrada por mensaje agrupando PUSH y EMAIL, con contador de no leídas) y operaciones administrativas de alta manual y consulta de estado de envío.\nEl API Gateway valida el JWT y propaga X-User-Id / X-User-Role.\n",
    "contact": {
      "name": "Equipo TicketYa — TUDAi 2026",
      "email": "equipo@ticketya.com.ar"
    },
    "license": {
      "name": "Uso académico — TUDAi 2026"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8086",
      "description": "Local — directo al microservicio"
    },
    {
      "url": "http://localhost:8080/api",
      "description": "Local — vía API Gateway (StripPrefix=1)",
      "x-gateway": true
    },
    {
      "url": "https://ticketya.com.ar/api",
      "description": "Producción — vía API Gateway",
      "x-gateway": true
    }
  ],
  "tags": [
    {
      "name": "Bandeja",
      "description": "Notificaciones del usuario autenticado (/notificaciones/me)."
    },
    {
      "name": "Administración",
      "description": "Alta administrativa y consulta de estado de envío (solo ADMIN)."
    },
    {
      "name": "Salud",
      "description": "Smoke del microservicio."
    }
  ],
  "paths": {
    "/notificaciones": {
      "get": {
        "tags": [
          "Salud"
        ],
        "summary": "Smoke del servicio",
        "description": "Chequeo de infraestructura. No forma parte del contrato de negocio.",
        "operationId": "ok",
        "responses": {
          "200": {
            "description": "Servicio activo",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "microservicio notificaciones ok!"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Administración"
        ],
        "summary": "Crear notificación administrativa (solo ADMIN)",
        "description": "Registra una notificación en estado PENDIENTE para ser procesada por el job de envío.",
        "operationId": "crearAdministrativa",
        "parameters": [
          {
            "name": "X-User-Role",
            "in": "header",
            "description": "Rol del usuario autenticado (lo inyecta el gateway)",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "ADMIN"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificacionRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Notificación creada en estado PENDIENTE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificacionResponseDTO"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos. La API devuelve el mismo `ApiError` (timestamp/status/error/message/path).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Requiere rol ADMIN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/notificaciones/me/{id}/leida": {
      "patch": {
        "tags": [
          "Bandeja"
        ],
        "summary": "Marcar notificación como leída",
        "description": "Marca como leído el mensaje completo (todas las filas hermanas PUSH/EMAIL que comparten `clave_mensaje`) y registra `fechaLectura`.",
        "operationId": "marcarLeida",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "UUID del usuario autenticado",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "UUID de la notificación",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Notificación marcada como leída",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificacionResponseDTO"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Notificación no encontrada o pertenece a otro usuario (no se revela su existencia)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/notificaciones/{id}/estado": {
      "get": {
        "tags": [
          "Administración"
        ],
        "summary": "Consultar estado de envío de una notificación (solo ADMIN)",
        "description": "Estado de una notificación por id. Solo ADMIN.",
        "operationId": "estadoEnvio",
        "parameters": [
          {
            "name": "X-User-Role",
            "in": "header",
            "description": "Rol del usuario autenticado (lo inyecta el gateway)",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "ADMIN"
          },
          {
            "name": "id",
            "in": "path",
            "description": "UUID de la notificación",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado actual de la notificación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificacionResponseDTO"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Requiere rol ADMIN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Notificación no encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/notificaciones/me": {
      "get": {
        "tags": [
          "Bandeja"
        ],
        "summary": "Listar notificaciones propias",
        "description": "Devuelve una página de mensajes del usuario autenticado (una entrada por mensaje; si se envió por PUSH y EMAIL, `canales` informa ambos) junto con el contador `noLeidas`.",
        "operationId": "listarPropias",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "UUID del usuario autenticado (lo inyecta el gateway)",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "b0000000-0000-4000-8000-000000000001"
          },
          {
            "name": "page",
            "in": "query",
            "description": "Número de página (0-based)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            },
            "example": 0
          },
          {
            "name": "size",
            "in": "query",
            "description": "Tamaño de página (máximo 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            },
            "example": 20
          },
          {
            "name": "leida",
            "in": "query",
            "description": "Filtra por estado de lectura",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de notificaciones del usuario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificacionPageResponseDTO"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado o falta X-User-Id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/notificaciones/me/{id}": {
      "get": {
        "tags": [
          "Bandeja"
        ],
        "summary": "Consultar detalle de una notificación propia",
        "description": "Solo el dueño puede consultarla; si es ajena o no existe devuelve 404.",
        "operationId": "detallePropio",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "UUID del usuario autenticado",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "UUID de la notificación",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle de la notificación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificacionResponseDTO"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Notificación no encontrada o pertenece a otro usuario (no se revela su existencia)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/": {
      "get": {
        "tags": [
          "Salud"
        ],
        "summary": "Smoke raíz",
        "description": "Chequeo de infraestructura. No forma parte del contrato de negocio.",
        "operationId": "okRaiz",
        "responses": {
          "200": {
            "description": "Servicio activo",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "microservicio notificaciones ok!"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotificacionRequestDTO": {
        "type": "object",
        "description": "Alta administrativa de una notificación (ADMIN)",
        "properties": {
          "idUsuario": {
            "type": "string",
            "description": "UUID del destinatario",
            "example": "b0000000-0000-4000-8000-000000000001",
            "maxLength": 36,
            "minLength": 0
          },
          "idEventoOrigen": {
            "type": [
              "string",
              "null"
            ],
            "description": "UUID del evento que origina el aviso (opcional)",
            "maxLength": 36,
            "minLength": 0
          },
          "tipo": {
            "type": "string",
            "description": "Tipo de notificación",
            "example": "AVISO_ADMINISTRATIVO",
            "maxLength": 64,
            "minLength": 0
          },
          "canal": {
            "type": "string",
            "description": "Canal de entrega",
            "enum": [
              "PUSH",
              "EMAIL"
            ],
            "example": "PUSH",
            "maxLength": 32,
            "minLength": 0
          },
          "asunto": {
            "type": "string",
            "description": "Asunto del aviso",
            "example": "Mantenimiento programado",
            "maxLength": 255,
            "minLength": 0
          },
          "contenido": {
            "type": "string",
            "description": "Contenido del aviso",
            "example": "La plataforma estará en mantenimiento el domingo de 03:00 a 04:00.",
            "minLength": 1
          },
          "fechaCreacion": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Fecha de creación (opcional; por defecto, ahora)"
          }
        },
        "required": [
          "asunto",
          "canal",
          "contenido",
          "idUsuario",
          "tipo"
        ]
      },
      "NotificacionResponseDTO": {
        "type": "object",
        "description": "Notificación registrada y estado de entrega",
        "properties": {
          "id": {
            "type": "string",
            "description": "UUID de la notificación"
          },
          "idUsuario": {
            "type": "string",
            "description": "UUID del destinatario"
          },
          "idEventoOrigen": {
            "type": [
              "string",
              "null"
            ],
            "description": "UUID del evento de origen"
          },
          "tipo": {
            "type": "string",
            "description": "Tipo de notificación",
            "example": "COMPRA_CONFIRMADA"
          },
          "canal": {
            "type": "string",
            "description": "Canal de la fila representativa del mensaje",
            "example": "PUSH"
          },
          "canales": {
            "type": "array",
            "description": "Canales por los que se entregó el mensaje (PUSH, EMAIL)",
            "example": [
              "PUSH",
              "EMAIL"
            ],
            "items": {
              "type": "string"
            }
          },
          "asunto": {
            "type": "string",
            "description": "Asunto del aviso"
          },
          "contenido": {
            "type": "string",
            "description": "Contenido del aviso"
          },
          "destinatario": {
            "type": [
              "string",
              "null"
            ],
            "description": "Email de destino (canal EMAIL)",
            "example": "demo@ticketya.com"
          },
          "estado": {
            "type": "string",
            "description": "Estado de envío",
            "enum": [
              "PENDIENTE",
              "ENVIADA",
              "FALLIDA"
            ]
          },
          "fechaCreacion": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de creación"
          },
          "fechaEnvio": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Fecha de envío"
          },
          "leida": {
            "type": "boolean",
            "description": "Leída por el usuario en la bandeja"
          },
          "fechaLectura": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Fecha de lectura"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "description": "Error de la API de notificaciones (incluye errores de validación del body).",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Momento del error",
            "example": "2026-11-21T12:00:00Z"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "Código HTTP",
            "example": 404
          },
          "error": {
            "type": "string",
            "description": "Motivo HTTP",
            "example": "Not Found"
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Detalle del error"
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Path solicitado"
          }
        }
      },
      "NotificacionPageResponseDTO": {
        "type": "object",
        "description": "Página de notificaciones propias + contador de no leídas",
        "properties": {
          "content": {
            "type": "array",
            "description": "Notificaciones de la página",
            "items": {
              "$ref": "#/components/schemas/NotificacionResponseDTO"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "description": "Número de página (0-based)"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "Tamaño de página"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "description": "Total de elementos"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "description": "Total de páginas"
          },
          "noLeidas": {
            "type": "integer",
            "format": "int64",
            "description": "Mensajes visibles sin leer (badge de la campanita)"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "JWT emitido por POST /auth/login de msvc-usuarios.\nEl gateway valida la firma y propaga X-User-Id,\nX-User-Email, X-User-Role y X-User-Roles.\n",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
