{"openapi":"3.1.0","info":{"title":"TicketYa — Preferencias, historial y recomendaciones","description":"Preferencias explícitas del cliente (tipos de evento, ciudades,\nartistas, rango de precio), historial de compras ingerido desde\nRabbitMQ y recomendaciones híbridas (contenido + co-compra).\nEl API Gateway valida el JWT y propaga X-User-Id / X-User-Roles.\n","contact":{"name":"Equipo TicketYa — TUDAi 2026","email":"equipo@ticketya.com.ar"},"license":{"name":"Uso académico — TUDAi 2026"},"version":"1.0.0"},"servers":[{"url":"http://localhost:8085","description":"Local — directo al microservicio"},{"url":"http://localhost:8080/api","description":"Local — vía API Gateway (StripPrefix=1)","x-gateway":true},{"url":"https://ticketya.com.ar/api","description":"Producción — vía API Gateway","x-gateway":true}],"tags":[{"name":"Historial","description":"Compras registradas del cliente."},{"name":"Preferencias","description":"Preferencias del cliente y matching interno."},{"name":"Interno","description":"Operaciones internas entre microservicios."},{"name":"Recomendaciones","description":"Eventos sugeridos por preferencias, historial y co-compra."}],"paths":{"/preferencias/me":{"get":{"tags":["Preferencias"],"summary":"Consultar preferencias propias","description":"Devuelve defaults si el cliente todavía no tiene documento.","operationId":"obtenerPropias","parameters":[{"name":"X-User-Id","in":"header","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Preferencia"}}}}},"security":[{"bearerAuth":[]}]},"put":{"tags":["Preferencias"],"summary":"Actualizar preferencias propias","description":"Categorías/tipos de evento, ciudades, artistas y rango de precio.","operationId":"actualizarPropias","parameters":[{"name":"X-User-Id","in":"header","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PreferenciaRequest"