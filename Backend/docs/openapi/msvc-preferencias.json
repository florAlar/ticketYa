},"precioDesde":{"type":"number"},"destacado":{"type":"boolean"},"estado":{"type":"string"},"esAltaDemanda":{"type":"boolean"},"artistas":{"type":"array","items":{"type":"string"}},"motivo":{"type":"string","description":"Motivo legible de la recomendación","example":"Porque te gusta Metallica"}}},"LugarResumenDTO":{"type":"object","properties":{"nombre":{"type":"string"},"ciudad":{"type":"string"}}},"HistorialItem":{"type":"object","description":"Compra del cliente con snapshot del evento","properties":{"id":{"type":"string"},"tipo":{"type":"string"},"idEvento":{"type":"string"},"nombreEvento":{"type":"string"},"categoria":{"type":"string"},"ciudad":{"type":"string"},"artistas":{"type":"array","items":{"type":"string"}},"fechaEvento":{"type":"string","format":"date-time"},"fechaCompra":{"type":"string","format":"date-time"},"monto":{"type":"number"},"cantidadEntradas":{"type":"integer","format":"int32"}}},"Page":{"type":"object","description":"Página de resultados","properties":{"content":{"type":"array","items":{"$ref":"#/components/schemas/HistorialItem"}},"page":{"type":"integer","format":"int32"},"size":{"type":"integer","format":"int32"},"totalElements":{"type":"integer","format":"int64"},"totalPages":{"type":"integer","format":"int32"}}}},"securitySchemes":{"bearerAuth":{"type":"http","description":"JWT emitido por POST /auth/login de msvc-usuarios.\nEl gateway valida la firma y propaga X-User-Id,\nX-User-Email, X-User-Role y X-User-Roles.\n","scheme":"bearer","bearerFormat":"JWT"}}}}