/MatchingClientesRequestDTO"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"type":"string"}}}}}},"x-internal":{"value":"true"}}},"/internas/backfill":{"post":{"tags":["Interno"],"summary":"Backfill de compras al historial","description":"Importa las compras APROBADAS de msvc-ventas y las upsertea por idCompra.\nIdempotente. Requiere X-Internal-Token; no está expuesto por el gateway.\n","operationId":"backfill","parameters":[{"name":"X-Internal-Token","in":"header","description":"Token compartido entre microservicios","required":true}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/BackfillResult"}}}}},"x-internal":{"value":"true"}}},"/recomendaciones/me":{"get":{"tags":["Recomendaciones"],"summary":"Recomendaciones propias","description":"Híbrido: preferencias explícitas (tipo, ciudad, artistas, rango de precio)\n+ co-compra (“quienes compraron X también compraron Y”) + fallback a próximos\neventos con alta demanda. Excluye eventos ya comprados.\n","operationId":"paraMi","parameters":[{"name":"X-User-Id","in":"header","required":false,"schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":10}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/EventoRecomendado"}}}}}},"security":[{"bearerAuth":[]}]}},"/preferencias/clientes/{idCliente}/notificaciones":{"get":{"tags":["Preferencias"],"summary":"Preferencias de canal de un cliente (interno)","description":"Uso interno (Feign). Devuelve defaults si el cliente no tiene documento.","operationId":"notificacionesDeCliente","parameters":[{"name":"idCliente","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/NotificacionesPreferenciasDTO"}}}}},"x-internal":{"value":"true"}}},"/preferencias":{"get":{"tags":["Preferencias"],"operationId":"ok","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"string"}}}}}}},"/":{"get":{"tags":["Preferencias"],"operationId":"ok_1","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"string"}}}}}}},"/eventos/{id}/recomendaciones":{"get":{"tags":["Recomendaciones"],"summary":"Eventos similares a uno dado","description":"Público. Prioriza eventos comprados por clientes que compraron el evento\nfuente; si no hay señal, usa mismo artista, tipo y ciudad. Excluye el evento\nfuente. 404 si el evento no existe.\n","operationId":"similares","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":6}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/EventoRecomendado"}}}}}}}},"/clientes/{id}/historial":{"get":{"tags":["Historial"],"summary":"Historial de compras del cliente","description":"Dueño (X-User-Id == id) o ADMIN. Paginado, orden fechaCompra desc.","operationId":"historial","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"X-User-Id","in":"header","required":false,"schema":{"type":"string"}},{"name":"X-User-Roles","in":"header","required":false,"schema":{"type":"string"}},{"name":"page","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","required":false,"schema":{"type":"integer","format":"int32","default":20}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Page"}}}}},"security":[{"bearerAuth":[]}]}}},"components":{"schemas":{"NotificacionesPreferenciasDTO":{"type":"object","properties":{"push":{"type":"boolean"},"email":{"type":"boolean"},"tipos":{"type":"array","items":{"type":"string"}}}},"PreferenciaRequest":