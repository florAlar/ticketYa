{"openapi":"3.1.0","info":{"title":"TicketYa — Ventas, reservas, compras y pagos","description":"Disponibilidad comercial por sector, reservas temporales con TTL,\ncompras idempotentes, pagos mock y reintentos.\nEl API Gateway valida el JWT y propaga X-User-Id; este microservicio\nfiltra reservas/compras/pagos por la identidad recibida.\n","contact":{"name":"Equipo TicketYa — TUDAi 2026","email":"equipo@ticketya.com.ar"},"license":{"name":"Uso académico — TUDAi 2026"},"version":"1.0.0"},"servers":[{"url":"http://localhost:8083","description":"Local — directo al microservicio"},{"url":"http://localhost:8080/api","description":"Local — vía API Gateway (StripPrefix=1)","x-gateway":true},{"url":"https://ticketya.com.ar/api","description":"Producción — vía API Gateway","x-gateway":true}],"tags":[{"name":"Ventas","description":"Disponibilidad, reservas, compras, pagos y cupos comerciales."}],"paths":{"/reservas":{"post":{"tags":["Ventas"],"summary":"Crear reserva temporal","description":"Reserva cupo por sector con TTL (10 min por defecto). El cliente sale de\nX-User-Id. `Idempotency-Key` es opcional: si se repite, devuelve la reserva\nya creada para esa key.\n","operationId":"crearReserva","parameters":[{"name":"Idempotency-Key","in":"header","description":"Clave de idempotencia opcional para reintentos seguros","required":false,"schema":{"type":"string"},"example":"reserva-2026-03-14-0001"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReservaCreateRequest"}}},"required":true},"responses":{"201":{"description":"Reserva creada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Reserva"}}}},"400":{"description":"Body inválido o sin precio activo","content":{"*/*":{"schema":{"type":"string"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"Cupo insuficiente o límite por cliente superado","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/reservas/{id}/renovacion":{"post":{"tags":["Ventas"],"summary":"Renovar reserva","description":"Extiende el TTL de una reserva propia activa (no es automática ni ilimitada).","operationId":"renovar","parameters":[{"name":"id","in":"path","description":"UUID de la reserva","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Reserva renovada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Reserva"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Reserva inexistente","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"Reserva no activa o expirada","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/reservas/{id}/confirmacion":{"post":{"tags":["Ventas"],"summary":"Confirmar reserva","description":"Marca la intención de compra. Solo reservas propias y activas.","operationId":"confirmar","parameters":[{"name":"id","in":"path","description":"UUID de la reserva","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Reserva confirmada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Reserva"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Reserva inexistente","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"Estado o expiración no permiten confirmar","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/reservas/{id}/cancelacion":{"post":{"tags":["Ventas"],"summary":"Cancelar reserva","description":"Cancela una reserva propia y libera el cupo. No cancelable con compra en curso o aprobada.","operationId":"cancelar","parameters":[{"name":"id","in":"path","description":"UUID de la reserva","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Reserva cancelada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Reserva"}}}},"401":{"description"