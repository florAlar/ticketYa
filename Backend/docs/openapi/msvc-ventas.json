o simulado: APROBAR (default) | RECHAZAR","example":"APROBAR"},"proveedor":{"type":"string","description":"Proveedor de pago (default MOCK_PASARELA)","example":"MOCK_PASARELA"}}},"Pago":{"type":"object","description":"Pago registrado para una compra","properties":{"id":{"type":"string","description":"UUID del pago","example":"44444444-4444-4444-8444-444444444444"},"idCompra":{"type":"string","description":"UUID de la compra","example":"33333333-3333-4333-8333-333333333333"},"proveedor":{"type":"string","description":"Proveedor de pago","example":"MOCK_PASARELA"},"idTransaccionExterna":{"type":"string","description":"Identificador de la transacción en el proveedor","example":"MOCK-8f3a1c"},"monto":{"type":"number","description":"Importe pagado","example":190000.0},"estado":{"type":"string","description":"Estado: APROBADO | RECHAZADO","example":"APROBADO"},"fechaPago":{"type":"string","format":"date-time","description":"Fecha del pago","example":"2026-03-01T12:06:00"}}},"AbrirCupoItem":{"type":"object","description":"Capacidad comercial de un sector","properties":{"idSector":{"type":"string","description":"UUID del sector","example":"a0000000-0000-4000-8000-000000000001","minLength":1},"capacidadTotal":{"type":"integer","format":"int32","description":"Capacidad total a abrir","example":500,"minimum":1}},"required":["capacidadTotal","idSector"]},"AbrirCuposRequest":{"type":"object","description":"Sectores y capacidades para abrir el stock comercial","properties":{"sectores":{"type":"array","description":"Sectores a abrir (al menos uno)","items":{"$ref":"#/components/schemas/AbrirCupoItem"},"minItems":1}},"required":["sectores"]},"CupoSector":{"type":"object","description":"Disponibilidad de un sector del evento","properties":{"idSector":{"type":"string","description":"UUID del sector","example":"c0000000-0000-4000-8000-000000000011"},"capacidadTotal":{"type":"integer","format":"int32","description":"Capacidad total del sector","example":120},"cantidadDisponible":{"type":"integer","format":"int32","description":"Unidades libres","example":118},"cantidadReservada":{"type":"integer","format":"int32","description":"Unidades reservadas (TTL activo)","example":2},"cantidadVendida":{"type":"integer","format":"int32","description":"Unidades vendidas","example":0},"agotado":{"type":"boolean","description":"true si el sector no tiene unidades libres","example":false},"nivelCupo":{"type":"string","description":"Clasificación del disponible del sector","enum":["AGOTADO","ULTIMOS_LUGARES","MENOS_DE_50","MENOS_DE_100","OK"],"example":"MENOS_DE_100"},"nivelCupoLabel":{"type":"string","description":"Etiqueta para UI del sector","example":"Menos de 100"}}},"Disponibilidad":{"type":"object","description":"Disponibilidad comercial por sector y clasificación de cupo","properties":{"idEvento":{"type":"string","description":"UUID del evento","example":"d0000000-0000-4000-8000-000000000001"},"disponibleTotal":{"type":"integer","format":"int32","description":"Suma de unidades disponibles de todos los sectores","example":118},"agotado":{"type":"boolean","description":"true si no queda ninguna unidad","example":false},"nivelCupo":{"type":"string","description":"Clasificación del disponible total","enum":["AGOTADO","ULTIMOS_LUGARES","MENOS_DE_50","MENOS_DE_100","OK"],"example":"OK"},"nivelCupoLabel":{"type":"string","description":"Etiqueta para UI (null si OK o sin aviso)","example":"Últimos lugares"},"sectores":{"type":"array","description":"Disponibilidad por sector","items":{"$ref":"#/components/schemas/CupoSector"}}}},"LiberarCupoRequest":{"type":"object","description":"Unidades a devolver al disponible de un sector","properties":{"idSector":{"type":"string","description":"UUID del sector","example":"a0000000-0000-4000-8000-000000000001","minLength":1},"cantidad":{"type":"integer","format":"int32","description":"Unidades a devolver","example":1,"minimum":1}},"required":["idSector"]},"CompraCreateRequest":{"type":"object","description":"Compra a crear d