/schemas/Disponibilidad"}}}},"400":{"description":"Body inválido o sin sectores","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"Conflicto al abrir el cupo","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/eventos/{id}/cupos/liberacion":{"post":{"tags":["Ventas"],"summary":"Liberar cupo por devolución","description":"Devuelve unidades al disponible del sector (devolución aprobada).\nUso principal: Feign desde msvc-entradas; vía gateway requiere ORGANIZADOR o ADMIN.\n","operationId":"liberarCupo","parameters":[{"name":"id","in":"path","description":"UUID del evento","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LiberarCupoRequest"}}},"required":true},"responses":{"200":{"description":"Cupo liberado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Disponibilidad"}}}},"400":{"description":"Body inválido (idSector/cantidad)","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Sector sin cupo comercial","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/compras":{"get":{"tags":["Ventas"],"summary":"Listar compras propias","description":"Compras del usuario autenticado.","operationId":"listCompras","responses":{"200":{"description":"Compras del usuario","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Compra"}}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]},"post":{"tags":["Ventas"],"summary":"Crear compra desde una reserva","description":"Convierte una reserva válida en compra. `Idempotency-Key` es **obligatoria**\n(400 si falta); repetir la key devuelve la compra ya creada.\n","operationId":"crearCompra","parameters":[{"name":"Idempotency-Key","in":"header","description":"Clave de idempotencia obligatoria","required":true,"schema":{"type":"string"},"example":"compra-