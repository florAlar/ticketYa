:{"description":"Resultado inválido","content":{"*/*":{"schema":{"type":"string"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Compra inexistente","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"La compra no admite pago en su estado","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/reservas/{id}":{"get":{"tags":["Ventas"],"summary":"Consultar reserva propia","description":"Solo devuelve reservas del usuario autenticado.","operationId":"getReserva","parameters":[{"name":"id","in":"path","description":"UUID de la reserva","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Reserva","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Reserva"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Reserva inexistente o de otro usuario","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/eventos/{id}/disponibilidad":{"get":{"tags":["Ventas"],"summary":"Disponibilidad de un evento","description":"Cupos por sector, total disponible y clasificación `nivelCupo`\n(AGOTADO | ULTIMOS_LUGARES | MENOS_DE_50 | MENOS_DE_100 | OK).\nEndpoint público a través del gateway.\n","operationId":"disponibilidad","parameters":[{"name":"id","in":"path","description":"UUID del evento","required":true,"schema":{"type":"string"},"example":"d0000000-0000-4000-8000-000000000001"}],"responses":{"200":{"description":"Disponibilidad del evento","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Disponibilidad"}}}},"404":{"description":"Evento sin cupos comerciales","content":{"*/*":{"schema":{"type":"string"}}}}}}},"/eventos/disponibilidad":{"get":{"tags":["Ventas"],"summary":"Disponibilidad de varios eventos","description":"Batch para catálogo: devuelve la disponibilidad comercial de hasta 50 eventos.\nEndpoint público a través del gateway.\n","operat