{"openapi":"3.1.0","info":{"title":"TicketYa — Ventas, reservas, compras y pagos","description":"Disponibilidad comercial por sector, reservas temporales con TTL,\ncompras idempotentes, pagos mock y reintentos.\nEl API Gateway valida el JWT y propaga X-User-Id; este microservicio\nfiltra reservas/compras/pagos por la identidad recibida.\n","contact":{"name":"Equipo TicketYa — TUDAi 2026","email":"equipo@ticketya.com.ar"},"license":{"name":"Uso académico — TUDAi 2026"},"version":"1.0.0"},"servers":[{"url":"http://localhost:8083","description":"Local — directo al microservicio"},{"url":"http://localhost:8080/api","description":"Local — vía API Gateway (StripPrefix=1)","x-gateway":true},{"url":"https://ticketya.com.ar/api","description":"Producción — vía API Gateway","x-gateway":true}],"tags":[{"name":"Ventas","description":"Disponibilidad, reservas, compras, pagos y cupos comerciales."},{"name":"Reportes","description":"Reportes del organizador sobre sus eventos: ventas, devoluciones, ocupación y recaudación."}],"paths":{"/reservas":{"post":{"tags":["Ventas"],"summary":"Crear reserva temporal","description":"Reserva cupo por sector con TTL (10 min por defecto). El cliente sale de\nX-User-Id. `Idempotency-Key` es opcional: si se repite, devuelve la reserva\nya creada para esa key.\n","operationId":"crearReserva","parameters":[{"name":"Idempotency-Key","in":"header","description":"Clave de idempotencia opcional para reintentos seguros","required":false,"schema":{"type":"string"},"example":"reserva-2026-03-14-0001"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReservaCreateRequest"}}},"required":true},"responses":{"201":{"description":"Reserva creada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Reserva"}}}},"400":{"description":"Body inválido o sin precio activo","content":{"*/*":{"schema":{"type":"string"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"Cupo insuficiente o límite por cliente superado","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/reservas/{id}/renovacion":{"post":{"tags":["Ventas"],"summary":"Renovar reserva","description":"Extiende el TTL de una reserva propia activa (no es automática ni ilimitada).","operationId":"renovar","parameters":[{"name":"id","in":"path","description":"UUID de la reserva","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Reserva renovada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Reserva"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Reserva inexistente","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"Reserva no activa o expirada","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/reservas/{id}/confirmacion":{"post":{"tags":["Ventas"],"summary":"Confirmar reserva","description":"Marca la intención de compra. Solo reservas propias y activas.","operationId":"confirmar","parameters":[{"name":"id","in":"path","description":"UUID de la reserva","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Reserva confirmada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Reserva"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Reserva inexistente","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"Estado o expiración no permiten confirmar","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/reservas/{id}/cancelacion":{"post":{"tags":["Ventas"],"summary":"Cancelar reserva","description":"Cancela una reserva propia y libera el cupo. No cancelable con compra en curso o aprobada.","operationId":"cancelar","parameters":[{"name":"id","in":"path","description":"UUID de la reserva","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Reserva cancelada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Reserva"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Reserva inexistente","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"Compra en curso/aprobada; no cancelable","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/pagos/{id}/reintentos":{"post":{"tags":["Ventas"],"summary":"Reintentar pago rechazado","description":"Solo se reintenta un pago RECHAZADO y una compra reintentable. Body opcional.","operationId":"reintentar","parameters":[{"name":"id","in":"path","description":"UUID del pago","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PagoCreateRequest"}}}},"responses":{"200":{"description":"Pago reintentado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Pago"}}}},"400":{"description":"Resultado inválido","content":{"*/*":{"schema":{"type":"string"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Pago inexistente","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"Pago no RECHAZADO, compra no reintentable o sin reserva activa","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/eventos/{id}/cupos":{"post":{"tags":["Ventas"],"summary":"Abrir cupos comerciales del evento","description":"Crea/asegura el stock por sector al publicar. Idempotente por (idEvento, idSector):\nsi el cupo ya existe no resetea vendido/reservado.\nUso principal: Feign desde msvc-eventos; vía gateway requiere ORGANIZADOR o ADMIN.\n","operationId":"abrirCupos","parameters":[{"name":"id","in":"path","description":"UUID del evento","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AbrirCuposRequest"}}},"required":true},"responses":{"201":{"description":"Cupos abiertos/asegurados","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Disponibilidad"}}}},"400":{"description":"Body inválido o sin sectores","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"Conflicto al abrir el cupo","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/eventos/{id}/cupos/liberacion":{"post":{"tags":["Ventas"],"summary":"Liberar cupo por devolución","description":"Devuelve unidades al disponible del sector (devolución aprobada).\nUso principal: Feign desde msvc-entradas; vía gateway requiere ORGANIZADOR o ADMIN.\n","operationId":"liberarCupo","parameters":[{"name":"id","in":"path","description":"UUID del evento","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LiberarCupoRequest"}}},"required":true},"responses":{"200":{"description":"Cupo liberado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Disponibilidad"}}}},"400":{"description":"Body inválido (idSector/cantidad)","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Sector sin cupo comercial","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/compras":{"get":{"tags":["Ventas"],"summary":"Listar compras propias","description":"Compras del usuario autenticado.","operationId":"listCompras","responses":{"200":{"description":"Compras del usuario","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Compra"}}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]},"post":{"tags":["Ventas"],"summary":"Crear compra desde una reserva","description":"Convierte una reserva válida en compra. `Idempotency-Key` es **obligatoria**\n(400 si falta); repetir la key devuelve la compra ya creada.\n","operationId":"crearCompra","parameters":[{"name":"Idempotency-Key","in":"header","description":"Clave de idempotencia obligatoria","required":true,"schema":{"type":"string"},"example":"compra-2026-03-14-0001"}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CompraCreateRequest"}}},"required":true},"responses":{"201":{"description":"Compra creada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Compra"}}}},"400":{"description":"Falta Idempotency-Key o body inválido","content":{"*/*":{"schema":{"type":"string"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Reserva inexistente","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"Reserva no activa o ya usada en otra compra","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/compras/{id}/pagos":{"get":{"tags":["Ventas"],"summary":"Listar pagos de una compra","description":"Pagos registrados para una compra propia.","operationId":"listPagos","parameters":[{"name":"id","in":"path","description":"UUID de la compra","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Pagos de la compra","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Pago"}}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Compra inexistente","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]},"post":{"tags":["Ventas"],"summary":"Iniciar pago de una compra","description":"Pago mock: `resultado` APROBAR (default) o RECHAZAR; `proveedor` opcional\n(default MOCK_PASARELA). Body opcional. Con APROBAR se dispara la emisión\nde entradas en msvc-entradas (reintentos + job).\n","operationId":"pagar","parameters":[{"name":"id","in":"path","description":"UUID de la compra","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PagoCreateRequest"}}}},"responses":{"201":{"description":"Pago registrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Pago"}}}},"400":{"description":"Resultado inválido","content":{"*/*":{"schema":{"type":"string"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Compra inexistente","content":{"*/*":{"schema":{"type":"string"}}}},"409":{"description":"La compra no admite pago en su estado","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/reservas/{id}":{"get":{"tags":["Ventas"],"summary":"Consultar reserva propia","description":"Solo devuelve reservas del usuario autenticado.","operationId":"getReserva","parameters":[{"name":"id","in":"path","description":"UUID de la reserva","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Reserva","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Reserva"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Reserva inexistente o de otro usuario","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/reportes/eventos/{idEvento}":{"get":{"tags":["Reportes"],"summary":"Reporte completo del evento","description":"Totales y detalle por sector (ventas, devoluciones, ocupación y recaudación). ORGANIZADOR dueño del evento o ADMIN. Importes y conteos según las definiciones de ReporteEvento.","operationId":"reporte","parameters":[{"name":"idEvento","in":"path","description":"UUID del evento","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Reporte","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteEvento"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteEvento"}}}},"403":{"description":"No es ADMIN ni el organizador del evento","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteEvento"}}}},"404":{"description":"Evento inexistente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteEvento"}}}},"503":{"description":"No se pudo consultar eventos o entradas","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteEvento"}}}}},"security":[{"bearerAuth":[]}]}},"/reportes/eventos/{idEvento}/ventas":{"get":{"tags":["Reportes"],"summary":"Ventas del evento","description":"Compras aprobadas y entradas vendidas, devueltas, vigentes e ingresadas. ORGANIZADOR dueño del evento o ADMIN. Importes y conteos según las definiciones de ReporteEvento.","operationId":"ventas","parameters":[{"name":"idEvento","in":"path","description":"UUID del evento","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Ventas","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteVentas"}}}},"403":{"description":"No es ADMIN ni el organizador del evento","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteVentas"}}}},"404":{"description":"Evento inexistente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteVentas"}}}}},"security":[{"bearerAuth":[]}]}},"/reportes/eventos/{idEvento}/sectores":{"get":{"tags":["Reportes"],"summary":"Ventas y devoluciones por sector","description":"Una fila por sector con vendidas, devueltas, ocupación y recaudación. ORGANIZADOR dueño del evento o ADMIN. Importes y conteos según las definiciones de ReporteEvento.","operationId":"sectores","parameters":[{"name":"idEvento","in":"path","description":"UUID del evento","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Sectores","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ReporteSector"}}}}},"403":{"description":"No es ADMIN ni el organizador del evento","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ReporteSector"}}}}},"404":{"description":"Evento inexistente","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ReporteSector"}}}}}},"security":[{"bearerAuth":[]}]}},"/reportes/eventos/{idEvento}/recaudacion":{"get":{"tags":["Reportes"],"summary":"Recaudación del evento","description":"Recaudación bruta, devuelta, pendiente de reintegro y neta, total y por sector. ORGANIZADOR dueño del evento o ADMIN. Importes y conteos según las definiciones de ReporteEvento.","operationId":"recaudacion","parameters":[{"name":"idEvento","in":"path","description":"UUID del evento","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Recaudación","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteRecaudacion"}}}},"403":{"description":"No es ADMIN ni el organizador del evento","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteRecaudacion"}}}},"404":{"description":"Evento inexistente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteRecaudacion"}}}}},"security":[{"bearerAuth":[]}]}},"/reportes/eventos/{idEvento}/ocupacion":{"get":{"tags":["Reportes"],"summary":"Porcentaje de ocupación","description":"Ocupación total y por sector (entradas vigentes / capacidad). ORGANIZADOR dueño del evento o ADMIN. Importes y conteos según las definiciones de ReporteEvento.","operationId":"ocupacion","parameters":[{"name":"idEvento","in":"path","description":"UUID del evento","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Ocupación","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteOcupacion"}}}},"403":{"description":"No es ADMIN ni el organizador del evento","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteOcupacion"}}}},"404":{"description":"Evento inexistente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteOcupacion"}}}}},"security":[{"bearerAuth":[]}]}},"/eventos/{id}/disponibilidad":{"get":{"tags":["Ventas"],"summary":"Disponibilidad de un evento","description":"Cupos por sector, total disponible y clasificación `nivelCupo`\n(AGOTADO | ULTIMOS_LUGARES | MENOS_DE_50 | MENOS_DE_100 | OK).\nEndpoint público a través del gateway.\n","operationId":"disponibilidad","parameters":[{"name":"id","in":"path","description":"UUID del evento","required":true,"schema":{"type":"string"},"example":"d0000000-0000-4000-8000-000000000001"}],"responses":{"200":{"description":"Disponibilidad del evento","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Disponibilidad"}}}},"404":{"description":"Evento sin cupos comerciales","content":{"*/*":{"schema":{"type":"string"}}}}}}},"/eventos/disponibilidad":{"get":{"tags":["Ventas"],"summary":"Disponibilidad de varios eventos","description":"Batch para catálogo: devuelve la disponibilidad comercial de hasta 50 eventos.\nEndpoint público a través del gateway.\n","operationId":"disponibilidadBatch","parameters":[{"name":"ids","in":"query","description":"Ids de evento separados por coma (máx. 50)","required":false,"schema":{"type":"array","items":{"type":"string"}},"example":"d0000000-0000-4000-8000-000000000001,d0000000-0000-4000-8000-000000000002"}],"responses":{"200":{"description":"Disponibilidad por evento","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DisponibilidadBatch"}}}},"400":{"description":"Lista de ids inválida o demasiado grande","content":{"*/*":{"schema":{"type":"string"}}}}}}},"/compras/{id}":{"get":{"tags":["Ventas"],"summary":"Consultar compra propia","description":"Solo devuelve compras del usuario autenticado.","operationId":"getCompra","parameters":[{"name":"id","in":"path","description":"UUID de la compra","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Compra","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Compra"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Compra inexistente o de otro usuario","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/":{"get":{"tags":["Ventas","Smoke"],"summary":"Smoke del microservicio","description":"Chequeo de infraestructura. No forma parte del contrato de negocio.","operationId":"ok","responses":{"200":{"description":"Texto de estado","content":{"*/*":{"schema":{"type":"string"}}}}},"x-internal":{"value":"true"}}}},"components":{"schemas":{"AsientoRef":{"type":"object","description":"Asiento de un sector numerado (fila + número)","properties":{"fila":{"type":"string","description":"Fila (A..Z, AA..)","example":"C","minLength":1},"numero":{"type":"integer","format":"int32","description":"Número de asiento dentro de la fila (desde 1)","example":14,"minimum":1}},"required":["fila","numero"]},"ReservaCreateRequest":{"type":"object","description":"Reserva temporal de cupos por sector","properties":{"idEvento":{"type":"string","description":"UUID del evento","example":"d0000000-0000-4000-8000-000000000001","minLength":1},"items":{"type":"array","description":"Sectores y cantidades a reservar","items":{"$ref":"#/components/schemas/ReservaItem"},"minItems":1}},"required":["idEvento","items"]},"ReservaItem":{"type":"object","description":"Sector a reservar: sector general = cantidad; sector numerado = asientos concretos","properties":{"idSector":{"type":"string","description":"UUID del sector","example":"c0000000-0000-4000-8000-000000000011","minLength":1},"cantidad":{"type":"integer","format":"int32","description":"Cantidad de entradas. Obligatoria en sectores generales (mín. 1; máx. por cliente aplica en servidor). En sectores numerados se ignora (vale la cantidad de asientos); si se envía debe coincidir.","example":2,"minimum":1},"asientos":{"type":["array","null"],"description":"Asientos pedidos (fila + número). Obligatorio en sectores numerados y no admitido en sectores generales.","items":{"$ref":"#/components/schemas/AsientoRef"}}},"required":["idSector"]},"Asiento":{"type":"object","description":"Asiento tomado de un sector numerado","properties":{"fila":{"type":"string","description":"Fila","example":"C"},"numero":{"type":"integer","format":"int32","description":"Número dentro de la fila","example":14},"estado":{"type":"string","description":"RESERVADO (con TTL) o VENDIDO","enum":["RESERVADO","VENDIDO"],"example":"RESERVADO"}}},"DetalleReserva":{"type":"object","description":"Línea de reserva: sector, cantidad y precio unitario","properties":{"idDetalle":{"type":"string","description":"UUID del detalle","example":"22222222-2222-4222-8222-222222222222"},"idSector":{"type":"string","description":"UUID del sector","example":"c0000000-0000-4000-8000-000000000011"},"cantidad":{"type":"integer","format":"int32","description":"Cantidad reservada","example":2},"precioUnitario":{"type":"number","description":"Precio unitario","example":95000.0},"asientos":{"type":"array","description":"Asientos reservados (solo sectores numerados; vacío en sectores generales)","items":{"$ref":"#/components/schemas/Asiento"}}}},"Reserva":{"type":"object","description":"Reserva temporal con TTL y detalle por sector","properties":{"id":{"type":"string","description":"UUID de la reserva","example":"11111111-1111-4111-8111-111111111111"},"idCliente":{"type":"string","description":"UUID del cliente","example":"b0000000-0000-4000-8000-000000000001"},"idEvento":{"type":"string","description":"UUID del evento","example":"d0000000-0000-4000-8000-000000000001"},"fechaCreacion":{"type":"string","format":"date-time","description":"Fecha de creación","example":"2026-03-01T12:00:00"},"fechaExpiracion":{"type":"string","format":"date-time","description":"Expiración del TTL","example":"2026-03-01T12:10:00"},"estado":{"type":"string","description":"Estado: ACTIVA | CONFIRMADA | CANCELADA | EXPIRADA","example":"ACTIVA"},"total":{"type":"number","description":"Total de la reserva","example":190000.0},"detalles":{"type":"array","description":"Detalle por sector","items":{"$ref":"#/components/schemas/DetalleReserva"}}}},"PagoCreateRequest":{"type":"object","description":"Datos del pago mock; el body completo es opcional","properties":{"resultado":{"type":"string","description":"Resultado simulado: APROBAR (default) | RECHAZAR","example":"APROBAR"},"proveedor":{"type":"string","description":"Proveedor de pago (default MOCK_PASARELA)","example":"MOCK_PASARELA"}}},"Pago":{"type":"object","description":"Pago registrado para una compra","properties":{"id":{"type":"string","description":"UUID del pago","example":"44444444-4444-4444-8444-444444444444"},"idCompra":{"type":"string","description":"UUID de la compra","example":"33333333-3333-4333-8333-333333333333"},"proveedor":{"type":"string","description":"Proveedor de pago","example":"MOCK_PASARELA"},"idTransaccionExterna":{"type":"string","description":"Identificador de la transacción en el proveedor","example":"MOCK-8f3a1c"},"monto":{"type":"number","description":"Importe pagado","example":190000.0},"estado":{"type":"string","description":"Estado: APROBADO | RECHAZADO","example":"APROBADO"},"fechaPago":{"type":"string","format":"date-time","description":"Fecha del pago","example":"2026-03-01T12:06:00"}}},"AbrirCupoItem":{"type":"object","description":"Capacidad comercial de un sector","properties":{"idSector":{"type":"string","description":"UUID del sector","example":"a0000000-0000-4000-8000-000000000001","minLength":1},"capacidadTotal":{"type":"integer","format":"int32","description":"Capacidad total a abrir","example":500,"minimum":1}},"required":["capacidadTotal","idSector"]},"AbrirCuposRequest":{"type":"object","description":"Sectores y capacidades para abrir el stock comercial","properties":{"sectores":{"type":"array","description":"Sectores a abrir (al menos uno)","items":{"$ref":"#/components/schemas/AbrirCupoItem"},"minItems":1}},"required":["sectores"]},"CupoSector":{"type":"object","description":"Disponibilidad de un sector del evento","properties":{"idSector":{"type":"string","description":"UUID del sector","example":"c0000000-0000-4000-8000-000000000011"},"capacidadTotal":{"type":"integer","format":"int32","description":"Capacidad total del sector","example":120},"cantidadDisp