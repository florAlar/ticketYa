sponses":{"200":{"description":"Ocupación","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteOcupacion"}}}},"403":{"description":"No es ADMIN ni el organizador del evento","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteOcupacion"}}}},"404":{"description":"Evento inexistente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReporteOcupacion"}}}}},"security":[{"bearerAuth":[]}]}},"/eventos/{id}/disponibilidad":{"get":{"tags":["Ventas"],"summary":"Disponibilidad de un evento","description":"Cupos por sector, total disponible y clasificación `nivelCupo`\n(AGOTADO | ULTIMOS_LUGARES | MENOS_DE_50 | MENOS_DE_100 | OK).\nEndpoint público a través del gateway.\n","operationId":"disponibilidad","parameters":[{"name":"id","in":"path","description":"UUID del evento","required":true,"schema":{"type":"string"},"example":"d0000000-0000-4000-8000-000000000001"}],"responses":{"200":{"description":"Disponibilidad del evento","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Disponibilidad"}}}},"404":{"description":"Evento sin cupos comerciales","content":{"*/*":{"schema":{"type":"string"}}}}}}},"/eventos/disponibilidad":{"get":{"tags":["Ventas"],"summary":"Disponibilidad de varios eventos","description":"Batch para catálogo: devuelve la disponibilidad comercial de hasta 50 eventos.\nEndpoint público a través del gateway.\n","operationId":"disponibilidadBatch","parameters":[{"name":"ids","in":"query","description":"Ids de evento separados por coma (máx. 50)","required":false,"schema":{"type":"array","items":{"type":"string"}},"example":"d0000000-0000-4000-8000-000000000001,d0000000-0000-4000-8000-000000000002"}],"responses":{"200":{"description":"Disponibilidad por evento","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DisponibilidadBatch"}}}},"400":{"description":"Lista de ids inválida o demasiado grande","content":{"*/*":{"schema":{"type":"string"}}}}}}},"/compras/{id}":{"get":{"tags":["Ventas"],"summary":"Consultar compra propia","description":"Solo devuelve compras del usuario autenticado.","operationId":"getCompra","parameters":[{"name":"id","in":"path","description":"UUID de la compra","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Compra","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Compra"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"type":"string"}}}},"404":{"description":"Compra inexistente o de otro usuario","content":{"*/*":{"schema":{"type":"string"}}}}},"security":[{"bearerAuth":[]}]}},"/":{"get":{"tags":["Ventas","Smoke"],"summary":"Smoke del microservicio","description":"Chequeo de infraestructura. No forma parte del contrato de negocio.","operationId":"ok","responses":{"200":{"description":"Texto de estado","content":{"*/*":{"schema":{"type":"string"}}}}},"x-internal":{"value":"true"}}},"/eventos/{idEvento}/fila/ingreso":{"post":{"tags":["Fila virtual"],"summary":"Ingresar a la fila","description":"Idempotente: 201 la primera vez, 200 si ya estaba. Solo eventos PUBLICADO con esAltaDemanda=true.","operationId":"ingresarFila","parameters":[{"name":"idEvento","in":"path","description":"UUID del evento (el gateway lo documenta como {id})","required":true,"schema":{"type":"string"},"example":"d0000000-0000-4000-8000-000000000001"}],"responses":{"201":{"description":"Primera entrada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/FilaPosicion"},"example":{"idEvento":"d0000000-0000-4000-8000-000000000001","posicion":57,"posicionHabilitadaHasta":50,"delante":7,"estado":"EN_ESPERA"}}}},"200":{"description":"Reingreso con la misma posición","content":{"*/*":{"schema":{"$ref":"#/components/schemas/FilaPosicion"},"example":{"idEvento":"d0000000-0000-4000-8000-000000000001","posicion":57,"posicionHabilitadaHasta":50,"delante":7,"estado":"EN_ESPERA"}}}},"401":{"description":"Falta X-User-Id (el gateway la inyecta desde el JWT)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"},"example":{"timestamp":"2026-11-19T15:20:00Z","status":401,"error":"Unauthorized","message":"Falta identidad del cliente"}}}},"409":{"description":"FILA_EVENTO_NO_ELEGIBLE o FILA_TURNO_USADO","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"},"example":{"status":409,"error":"Conflict","message":"El turno ya fue usado","code":"FILA_TURNO_USADO"}}},"x-error-codes":["FILA_EVENTO_NO_ELEGIBLE","FILA_TURNO_USADO"]},"503":{"description":"Redis no disponible (fail-closed)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"},"example":{"timestamp":"2026-11-19T15:20:00Z","status":503,"error":"Service Unavailable","message":"La fila no está disponible","code":"FILA_NO_DISPONIBLE"}}},"x-error-codes":["FILA_NO_DISPONIBLE"]}},"security":[{"bearerAuth":[]}]}},"/eventos/{idEvento}/fila/posicion":{"get":{"tags":["Fila virtual"],"summary":"Posición propia","description":"Turno inmutable, tanda y cuánto falta (delante).","operationId":"posicionFila","parameters":[{"name":"idEvento","in":"path","description":"UUID del evento (el gateway lo documenta como {id})","required":true,"schema":{"type":"string"},"example":"d0000000-0000-4000-8000-000000000001"}],"responses":{"200":{"description":"Posición","content":{"*/*":{"schema":{"$ref":"#/components/schemas/FilaPosicionDetalle"},"example":{"idEvento":"d0000000-0000-4000-8000-000000000001","posicion":57,"posicionHabilitadaHasta":50,"delante":0,"estado":"HABILITADO"}}}},"404":{"description":"FILA_NO_INGRESADO o evento inexistente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"},"example":{"timestamp":"2026-11-19T15:20:00Z","status":404,"error":"Not Found","message":"El cliente no ingresó a la fila","code":"FILA_NO_INGRESADO"}}},"x-error-codes":["FILA_NO_INGRESADO"]},"409":{"description":"FILA_EVENTO_NO_ELEGIBLE","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"},"example":{"status":409,"message":"El evento no es elegible","code":"FILA_EVENTO_NO_ELEGIBLE"}}},"x-error-codes":["FILA_EVEN