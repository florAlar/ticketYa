{"openapi":"3.1.0","info":{"title":"TicketYa — Usuarios y autenticación","description":"Identidad, sesión y administración de usuarios de TicketYa.\nLa autenticación y el RBAC los aplica el API Gateway; este microservicio\nconfía en los headers X-User-Id / X-User-Role propagados tras validar el JWT.\n","contact":{"name":"Equipo TicketYa — TUDAi 2026","email":"equipo@ticketya.com.ar"},"license":{"name":"Uso académico — TUDAi 2026"},"version":"1.0.0"},"servers":[{"url":"http://localhost:8081","description":"Local — directo al microservicio"},{"url":"http://localhost:8080/api","description":"Local — vía API Gateway (StripPrefix=1)","x-gateway":true},{"url":"https://ticketya.com.ar/api","description":"Producción — vía API Gateway","x-gateway":true}],"tags":[{"name":"Usuarios","description":"Perfil propio y administración de usuarios (ADMIN en el gateway)."},{"name":"Auth","description":"Registro, login, refresh y logout. Vía gateway: /api/auth/**."}],"paths":{"/usuarios/{id}/roles":{"get":{"tags":["Usuarios"],"summary":"Consultar roles de un usuario","description":"Roles asignados. Restringido a ADMIN en el gateway.","operationId":"getRoles","parameters":[{"name":"id","in":"path","description":"UUID del usuario","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Nombres de roles","content":{"*/*":{"schema":{"type":"array","items":{"type":"string","example":"CLIENTE"}}}}},"404":{"description":"Usuario inexistente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}},"security":[{"bearerAuth":[]}]},"put":{"tags":["Usuarios"],"summary":"Reemplazar roles de un usuario","description":"Asigna el conjunto de roles indicado (reemplaza los anteriores). Acepta el alias ACCESO y lo normaliza a PERSONAL_ACCESO. Restringido a ADMIN.","operationId":"putRoles","parameters":[{"name":"id","in":"path","description":"UUID del usuario","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":