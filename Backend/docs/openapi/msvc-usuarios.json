,"/auth/login":{"post":{"tags":["Auth"],"summary":"Iniciar sesión","description":"Valida credenciales (BCrypt) y emite un JWT con userId, email, rol y roles.\nEndpoint público.\n","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"description":"Sesión iniciada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}}},"400":{"description":"Body inválido","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"401":{"description":"Credenciales inválidas o cuenta desactivada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}}}},"/usuarios/{id}/estado":{"patch":{"tags":["Usuarios"],"summary":"Activar o desactivar usuario","description":"Cambia el flag activo. Restringido a ADMIN en el gateway.","operationId":"patchEstado","parameters":[{"name":"id","in":"path","description":"UUID del usuario","required":true,"schema":{"type":"string"}}],"requestBody":{"description":"Estado deseado","content":{"application/json":{"schema":{"type":"object","example":{"activo":true}}}},"required":true},"responses":{"200":{"description":"Estado actualizado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Usuario"}}}},"400":{"description":"Falta el campo activo","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"Usuario inexistente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}},"security":[{"bearerAuth":[]}]}},"/usuarios/me":{"get":{"tags":["Usuarios"],"summary":"Obtener mi perfil","description":"Devuelve el usuario indicado por el header X-User-Id que propaga el gateway.","operationId":"me","parameters":[{"name":"X-User-Id","in":"header","description":"UUID del usuario autenticado (lo inyecta el gateway)","required":true,"schema":{"type":"string"},"example":"b0000000-0000-4000-8000-000000000001"}],"responses":{"200":{"description":"Perfil del usuario","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Usuario"}}}},"401":{"description":"Falta X-User-Id (no pasó por el gateway)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"Usuario inexistente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}},"security":[{"bearerAuth":[]}]},"patch":{"tags":["Usuarios"],"summary":"Editar mi perfil","description":"Actualiza nombre, apellido y ciudad. Email, roles y estado no se modifican.","operationId":"patchMe","parameters":[{"name":"X-User-Id","in":"header","description":"UUID del usuario autenticado","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UsuarioUpdate"}}},"required":true},"responses":{"200":{"description":"Perfil actualizado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Usuario"}}}},"400":{"description":"Body inválido","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"401":{"description":"Falta X-User-Id","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"Usuario inexistente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}},"security":[{"bearerAuth":[]}]}},"/usuarios":{"get":{"tags":["Usuarios"],"summary":"Listar usuarios","description":"Listado completo con roles. En el gateway está restringido a ADMIN.","operationId":"listAll","responses":{"200":{"description":"Listado de usuarios","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Usuario"}}}}},"403":{"description":"Rol insuficiente (gateway exige ADMIN)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}},"security":[{"bearerAuth":[]}]}},"/usuarios/{id}":{"get":{"tags":["Usuarios"],"summary":"Obtener usuario por id","description":"Detalle de cualquier usuario. En el gateway está restringido a ADMIN.","operationId":"byId","parameters":[{"name":"id","in":"path","description":"UUID del usuario","required":true,"schema":{"type":"string"},"example":"b0000000-0000-4000-8000-000000000002"}],"responses":{"200":{"description":"Usuario encontrado","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Usuario"}}}},"404":{"description":"Usuario inexistente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiError"}}}}},"security":[{"bearerAuth":[]}]}},"/":{"get":{"tags":["Usuarios","Smoke"],"summary":"Smoke del microservicio","description":"Chequeo de infraestructura. No forma parte del contrato de negocio.","operationId":"ok","responses":{"200":{"description":"Texto de estado","content":{"*/*":{"schema":{"type":"string"}}}}},"x-internal":{"value":"true"}}}},"components":{"schemas":{"RolesUpdate":{"type":"object","description":"Conjunto de roles a asignar (reemplaza los anteriores)","properties":{"roles":{"type":"array","description":"Nombres de rol: CLIENTE, ORGANIZADOR, ADMIN, PERSONAL_ACCESO (ACCESO se normaliza)","example":["CLIENTE","ORGANIZADOR"],"items":{"type":"string"},"minItems":1}},"required":["roles"]},"ApiError":{"type":"object","properties":{"timestamp":{"type":"string"},"status":{"type":"integer","format":"int32"},"error":{"type":"string"},"message":{"type":"string"},"path":{"type":"string"}}},"RegisterRequest":{"type":"object","description":"Alta pública de cliente","properties":{"nombre":{"type":"string","description":"Nombre","example":"Ana","maxLength":100,"minLength":2},"email":{"type":"string","format":"email","description":"Email único","example":"ana@example.com","minLength":1},"password":{"type":"string","description":"Contraseña (mínimo 6 caracteres)","example":"secreto123","maxLength":100,"minLength":6},"apellido":{"type":"string","description":"Apellido","example":"Pérez"},"ciudad":{"type":"string","description":"Ciudad","example":"Buenos Aires"}},"required":["email","nombre","password"]},"LoginResponse":{"type":"object","description":"Sesión emitida: token + datos del usuario","properties":{"token":{"type":"string","description":"JWT a enviar como Bearer","example":"eyJhbGciOiJIUzI1NiJ9..."},"type":{"type":"string","description":"Tipo de token","example":"Bearer"},"user":{"$ref":"#/components/schemas/UserSession","description":"Datos de sesión"}}},"UserSession":{"type":"object","description":"Usuario autenticado y sus roles","properties":{"id":{"type":"string","description":"UUID del usuario","example":"b0000000-0000-4000-8000-000000000001"},"email":{"type":"string","description":"Email","example":"demo@ticketya.com"},"nombre":{"type":"string","description":"Nombre","example":"Usuario Demo"},"rol":{"type":"string","description":"Rol principal","example":"CLIENTE"},"roles":{"type":"array","description":"Todos los roles del usuario","example":["CLIENTE"],"items":{"type":"string"}},"activo":{"type":"boolean","description":"Cuenta activa","example":true}}},"LoginRequest":{"type":"object","description":"Credenciales de acceso","properties":{"email":{"type":"string","format":"email","description":"Email registrado","example":"demo@ticketya.com","minLength":1},"password":{"type":"string","description":"Contraseña","example":"demo1234","minLength":1}},"required":["email","password"]},"Usuario":{"type":"object","description":"Usuario con su rol principal y todos sus roles","properties":{"id":{"type":"string","description":"UUID del usuario","example":"b0000000-0000-4000-8000-000000000001"},"email":{"type":"string","description":"Email único","example":"demo@ticketya.com"},"nombre":{"type":"string","description":"Nombre","example":"Usuario"},"apellido":{"type":"string","description":"Apellido","example":"Demo"},"ciudad":{"type":"string","description":"Ciudad","example":"Buenos Aires"},"activo":{"type":"boolean","description":"Cuenta activa","example":true},"rol":{"type":"string","description":"Rol principal","example":"CLIENTE"},"roles":{"type":"array","description":"Roles asignados","example":["CLIENTE"],"items":{"type":"string"}}}},"UsuarioUpdate":{"type":"object","description":"Campos editables del perfil propio","properties":{"nombre":{"type":"string","description":"Nombre","example":"Ana","maxLength":100,"minLength":2},"apellido":{"type":"string","description":"Apellido","example":"Pérez","maxLength":100,"minLength":0},"ciudad":{"type":"string","description":"Ciudad","example":"Rosario","maxLength":120,"minLength":0}}}},"securitySchemes":{"bearerAuth":{"type":"http","description":"JWT emitido por POST /auth/login (o /auth/refresh).\nEl gateway valida la firma y propaga X-User-Id, X-User-Email,\nX-User-Role y X-User-Roles a los microservicios.\n","scheme":"bearer","bearerFormat":"JWT"}}}}