# Front TicketYa → API Gateway (desarrollo local con `npm run dev`).
# Este archivo se versiona: NO tiene secretos, solo la URL del gateway y el flag de mock.
# Requiere el backend corriendo: `cd Backend && docker compose up -d --build`.
VITE_API_BASE_URL=http://localhost:8080

# Único interruptor (no se mezcla mock y backend):
#   false = TODO contra el backend real; lo que el BE no implementa queda deshabilitado.
#   true  = TODO en mock local (sin backend), solo para demo offline.
VITE_USE_MOCK=false
