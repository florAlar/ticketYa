# Front TicketYa → API Gateway
VITE_API_BASE_URL=http://localhost:8080

# true = mock global por defecto (entradas, soporte, gestión extra…)
VITE_USE_MOCK=true

# Overrides por módulo (si se omiten, heredan VITE_USE_MOCK)
# Compras reales necesitan auth + eventos en false:
# VITE_USE_MOCK_AUTH=false
# VITE_USE_MOCK_EVENTOS=false
# VITE_USE_MOCK_COMPRAS=false
